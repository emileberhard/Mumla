        {
          "product-name": "SpeechKit",
          "build-phase": {
            "build-phase": "frameworks"
          }
        }
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS[config=Debug]": "Mumla/MumlaDev.entitlements",
        "CODE_SIGN_ENTITLEMENTS[config=Release]": "Mumla/Mumla.entitlements",
        "CODE_SIGN_IDENTITY[config=Debug]": "Apple Development",
        "COMBINE_HIDPI_IMAGES": "YES",
        "ENABLE_APP_SANDBOX[config=Debug]": "NO",
        "ENABLE_APP_SANDBOX[config=Release]": "YES",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_RESOURCE_ACCESS_AUDIO_INPUT": "YES",
        "ENABLE_USER_SELECTED_FILES": "readonly",
        "INFOPLIST_FILE": "Apple/Config/MumlaMac-Info.plist",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks"
        ],
        "MACOSX_DEPLOYMENT_TARGET": "26.0",
        "OTHER_LDFLAGS": [
          "$(inherited)",
          "-L$(DT_TOOLCHAIN_DIR)/usr/lib/swift/$(PLATFORM_NAME)"
        ],
        "PRODUCT_BUNDLE_IDENTIFIER[config=Debug]": "emileberhard.WisprClone",
        "PRODUCT_BUNDLE_IDENTIFIER[config=Release]": "emileberhard.WisprClone.ios",
        "PRODUCT_NAME[config=Debug]": "Mumla Dev",
        "PRODUCT_NAME[config=Release]": "Mumla",
        "PROVISIONING_PROFILE_SPECIFIER[config=Debug]": "Mumla Mac Development",
        "SDKROOT": "macosx",
        "CODE_SIGN_STYLE[config=Release]": "Automatic",
        "CODE_SIGN_STYLE[config=Debug]": "Manual",
        "GENERATE_INFOPLIST_FILE": "NO",
        "EXCLUDED_SOURCE_FILE_NAMES": "$(inherited) *.entitlements"
      }
    },
