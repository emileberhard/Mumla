  "targets": [
    {
      "name": "MumlaKeyboard",
      "id": "TEMP_B9F7446F-076C-41C6-A5ED-FD314C37E627",
      "product": "Products/MumlaKeyboard.appex",
      "product-type": "app-extension",
      "build-phases": [
        "compile-sources",
        "resources",
        "frameworks",
        {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory"
        }
      ],
      "package-product-members": [
        {
          "product-name": "Sentry",
          "build-phase": {
            "build-phase": "frameworks"
          }
        }
      ],
      "build-settings": {
        "CODE_SIGN_ENTITLEMENTS": "ios/MumlaKeyboard/MumlaKeyboard.entitlements",
        "CODE_SIGN_IDENTITY[config=Debug]": "Apple Development",
        "INFOPLIST_FILE": "Apple/Config/MumlaKeyboard-Info.plist",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks"
        ],
        "OTHER_LDFLAGS": [
          "$(inherited)",
          "-L$(DT_TOOLCHAIN_DIR)/usr/lib/swift/$(PLATFORM_NAME)"
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "emileberhard.WisprClone.ios.keyboard",
        "PRODUCT_NAME": "MumlaKeyboard",
        "PROVISIONING_PROFILE_SPECIFIER[config=Debug]": "Mumla Keyboard Development",
        "SDKROOT": "iphoneos",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_OBJC_BRIDGING_HEADER": "ios/MumlaKeyboard/Sources/InputContextBridge.h",
        "TARGETED_DEVICE_FAMILY": "1",
        "CODE_SIGN_STYLE[config=Release]": "Automatic",
        "CODE_SIGN_STYLE[config=Debug]": "Manual",
        "GENERATE_INFOPLIST_FILE": "NO"
      }
    },
    {
      "name": "MumlaKeyboardTests",
      "id": "TEMP_1DC79244-29DF-4D87-8739-B4C9098D2EB0",
      "product": "Products/MumlaKeyboardTests.xctest",
      "product-type": "bundle.unit-test",
      "build-phases": [
        "compile-sources",
        "resources",
        "frameworks",
        {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory"
        }
      ],
      "package-product-members": [
        {
          "product-name": "Sentry",
          "build-phase": {
            "build-phase": "frameworks"
          }
        }
      ],
      "build-settings": {
        "CODE_SIGN_IDENTITY": "-",
        "INFOPLIST_FILE": "Apple/Config/MumlaKeyboardTests-Info.plist",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
          "@loader_path/../Frameworks"
        ],
        "MACOSX_DEPLOYMENT_TARGET": "26.0",
        "OTHER_LDFLAGS": [
          "$(inherited)",
          "-L$(DT_TOOLCHAIN_DIR)/usr/lib/swift/$(PLATFORM_NAME)"
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "emileberhard.WisprClone.KeyboardTests",
        "PRODUCT_NAME": "MumlaKeyboardTests",
        "SDKROOT": "macosx",
        "GENERATE_INFOPLIST_FILE": "NO"
      }
    },
    {
      "name": "MumlaMac",
      "id": "TEMP_EAFBD1FE-95B3-4B66-9361-36482DBD1207",
      "product": "Products/MumlaMac.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "resources",
        "frameworks",
        {
          "kind": "copy",
