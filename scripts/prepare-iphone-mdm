#!/usr/bin/env python3
import argparse
import json
from pathlib import Path
import plistlib

parser = argparse.ArgumentParser()
parser.add_argument('--app-path', type=Path, required=True)
parser.add_argument('--device-udid', required=True)
args = parser.parse_args()
app = args.app_path
infos = [app / 'Info.plist', *app.glob('PlugIns/*.appex/Info.plist')]
expected = {'emileberhard.WisprClone.ios', 'emileberhard.WisprClone.ios.keyboard'}
identities = {plistlib.loads(path.read_bytes())['CFBundleIdentifier'] for path in infos}
if identities != expected or len(infos) != len(expected):
    raise SystemExit('Expected exactly the Mumla iOS app and keyboard extension')
for path in infos:
    if any(key.startswith('LLMRouter') for key in plistlib.loads(path.read_bytes())):
        raise SystemExit(f'Router configuration was bundled: {path}')
for name in ['InstallKey.xcconfig', 'Local.xcconfig', 'shared-env.sh', '.env']:
    if any(app.rglob(name)):
        raise SystemExit(f'Private build configuration was bundled: {name}')
value = plistlib.loads((app / 'Info.plist').read_bytes())
if value.get('MumlaAccessOrigin') != 'https://mumla-access.esmadil.se':
    raise SystemExit('Unexpected access origin')
print(json.dumps({'schemaVersion': 1, 'uploadSafe': True, 'bundleIdentifier': value['CFBundleIdentifier'], 'version': value['CFBundleShortVersionString'], 'build': value['CFBundleVersion']}))
