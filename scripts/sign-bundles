#!/usr/bin/env python3
import json
import os
import plistlib
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def run(*args):
    return subprocess.run(args, capture_output=True, check=True).stdout


def main(mode, app, channel):
    bundles = json.loads((ROOT / f"Apple/Config/entitlements-{channel}.json").read_text())
    shipped = {"."} | {str(p.relative_to(app)) for pattern in ("*.app", "*.appex") for p in app.rglob(pattern)}
    if set(bundles) != shipped:
        raise SystemExit(f"The entitlement map must cover exactly the app bundles: {sorted(shipped)}")
    if mode == "sign":
        for framework in sorted(app.rglob("*.framework"), key=lambda path: len(path.parts), reverse=True):
            run("codesign", "--force", "--sign", "-", str(framework))
    else:
        authority = "Developer ID Application" if channel == "developer-id" else "Apple Distribution"
        for framework in app.rglob("*.framework"):
            signature = subprocess.run(["codesign", "-dvv", str(framework)], capture_output=True, check=True).stderr.decode()
            if f"Authority={authority}" not in signature:
                raise SystemExit(f"Exported {framework.relative_to(app)} is not signed with {authority}:\n{signature}")
    for bundle, source in sorted(bundles.items(), key=lambda item: len(Path(item[0]).parts), reverse=True):
        path = app / bundle
        wanted = {}
        if source is not None:
            text = (ROOT / source).read_text().replace("$(APP_BUNDLE_ID)", os.environ["APP_BUNDLE_ID"])
            text = text.replace("$(TeamIdentifierPrefix)", os.environ["DEVELOPMENT_TEAM"] + ".")
            if "$(" in text:
                raise SystemExit(f"Resolve unsupported build-setting substitutions in {source}.")
            wanted = plistlib.loads(text.encode())
        if mode == "sign":
            with tempfile.NamedTemporaryFile(suffix=".entitlements") as file:
                file.write(plistlib.dumps(wanted))
                file.flush()
                run("codesign", "--force", "--sign", "-", "--entitlements", file.name, str(path))
        else:
            actual = plistlib.loads(run("codesign", "-d", "--entitlements", "-", "--xml", str(path)))
            if "aps-environment" in wanted:
                wanted["aps-environment"] = "production"
            missing = {key: value for key, value in wanted.items() if actual.get(key) != value}
            if missing:
                raise SystemExit(f"Exported {bundle} lost required entitlements: {missing}")


if __name__ == "__main__":
    if len(sys.argv) != 4 or sys.argv[1] not in {"sign", "check"}:
        raise SystemExit("Usage: scripts/sign-bundles sign|check APP ios|macos|developer-id")
    try:
        main(sys.argv[1], Path(sys.argv[2]), sys.argv[3])
    except subprocess.CalledProcessError as error:
        raise SystemExit(error.stderr.decode())
