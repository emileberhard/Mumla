#!/usr/bin/env python3
import argparse
import fcntl
import json
import os
import platform
import shutil
import signal
import subprocess
import time
from contextlib import contextmanager
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
BUILD = ROOT / ".local" / "screenshot-build"
APP = BUILD / "Build/Products/Debug-iphonesimulator/MumlaiOS.app"
PREVIEWS = ROOT / ".local" / "ui-previews"
APP_STORE_SCREENS = ["keyboard", "dictionary", "transcripts"]
RESOLVED = ROOT / "Mumla.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved"
RESOLVED_COPY = BUILD / "Package.resolved"
APP_STORE_DISPLAYS = {
    "IPHONE_DYNAMIC_ISLAND_MEDIUM_PROFILE": "iPhone 18 Pro",
}
PREVIEW_DEVICE = "iPhone 18 Pro"
SHARED_SIMULATORS = Path.home() / "Library" / "Caches" / "ui-previews"
LISTING = ROOT / "Apple/AppStore/listing"
LOCALES = {
    "en-US": ["-AppleLanguages", "(en)", "-AppleLocale", "en_US"],
    "sv": ["-AppleLanguages", "(sv)", "-AppleLocale", "sv_SE"],
}
STATUS_BAR = ["--time", "9:41", "--dataNetwork", "wifi", "--wifiMode", "active", "--wifiBars", "3",
              "--cellularMode", "active", "--cellularBars", "4", "--batteryState", "charged", "--batteryLevel", "100"]


def run(*args, timeout=None):
    return subprocess.run([str(arg) for arg in args], check=True, text=True, capture_output=True, timeout=timeout).stdout.strip()


def cancel(signum, frame):
    raise SystemExit(128 + signum)


def latest_runtime(devices):
    runtimes = json.loads(run("xcrun", "simctl", "list", "runtimes", "--json"))["runtimes"]
    supported = [r for r in runtimes if r["isAvailable"] and r["platform"] == "iOS"
                 and all(any(t["name"] == device for t in r["supportedDeviceTypes"]) for device in devices)]
    if not supported:
        raise SystemExit(f"Install an iOS simulator runtime supporting {', '.join(devices)}.")
    return max(supported, key=lambda r: tuple(int(p) for p in r["version"].split(".")))["identifier"]


def build():
    if not (BUILD / "SourcePackages").exists() or not RESOLVED_COPY.exists() or RESOLVED.read_bytes() != RESOLVED_COPY.read_bytes():
        run("xcodebuild", "-resolvePackageDependencies", "-project", ROOT / "Mumla.xcodeproj", "-scheme", "MumlaiOS",
            "-derivedDataPath", BUILD, "-onlyUsePackageVersionsFromResolvedFile")
        shutil.copyfile(RESOLVED, RESOLVED_COPY)
    run("xcodebuild", "-quiet", "-project", ROOT / "Mumla.xcodeproj", "-scheme", "MumlaiOS",
        "-configuration", "Debug", "-destination", "generic/platform=iOS Simulator", "-derivedDataPath", BUILD,
        "-disableAutomaticPackageResolution", "-onlyUsePackageVersionsFromResolvedFile", "-skipPackageUpdates",
        f"ARCHS={platform.machine()}", "SWIFT_ACTIVE_COMPILATION_CONDITIONS=$(inherited) MUMLA_SCREENSHOTS",
        "MUMLA_CLOUDKIT_API_TOKEN=", "CODE_SIGNING_ALLOWED=NO", "COMPILER_INDEX_STORE_ENABLE=NO", "build")
    return run("plutil", "-extract", "CFBundleIdentifier", "raw", APP / "Info.plist")


def listing_locales():
    locales = sorted(path.name for path in LISTING.iterdir() if path.is_dir())
    unknown = sorted(set(locales) - set(LOCALES))
    if unknown:
        raise SystemExit(f"Add the app language for the App Store locales {', '.join(unknown)} to LOCALES.")
    return locales


def capture(udid, bundle, output, screens, appearance, locale, timeout):
    shutil.rmtree(output, ignore_errors=True)
    output.mkdir(parents=True)
    run("xcrun", "simctl", "status_bar", udid, "override", *STATUS_BAR)
    env = {**os.environ, "SIMCTL_CHILD_MUMLA_CAPTURE": str(output),
           "SIMCTL_CHILD_MUMLA_CAPTURE_APPEARANCE": appearance}
    if screens:
        env["SIMCTL_CHILD_MUMLA_CAPTURE_SCREENS"] = ",".join(screens)
    launch = ["xcrun", "simctl", "launch", "--terminate-running-process", "--console-pty", udid, bundle, *LOCALES[locale]]
    ready = output / "ready"
    console = output / "console.log"
    deadline = time.monotonic() + timeout
    expired = False
    with open(console, "w") as log:
        app = subprocess.Popen(launch, stdout=log, stderr=subprocess.STDOUT, env=env)
        try:
            while app.poll() is None:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    expired = True
                    break
                if ready.exists():
                    screen = ready.read_text().strip()
                    ready.unlink()
                    shot = output / f".{screen}.png"
                    try:
                        run("xcrun", "simctl", "io", udid, "screenshot", "--mask=black", shot, timeout=remaining)
                    except subprocess.TimeoutExpired:
                        expired = True
                        break
                    shot.rename(output / f"{screen}.png")
                else:
                    time.sleep(0.02)
        finally:
            if app.poll() is None:
                app.terminate()
                subprocess.run(["xcrun", "simctl", "terminate", udid, bundle], capture_output=True)
                app.wait()
    manifest = output / "manifest.json"
    if not manifest.exists():
        reason = f"exceeded the {timeout}-second deadline" if expired else "exited before finishing"
        raise SystemExit(f"The app {reason}:\n{console.read_text()}")
    return json.loads(manifest.read_text())


@contextmanager
def simulator_appearance(udid, appearance):
    previous = run("xcrun", "simctl", "ui", udid, "appearance")
    if previous not in ("light", "dark"):
        raise RuntimeError(f"Could not read simulator appearance: {previous}")
    run("xcrun", "simctl", "ui", udid, "appearance", appearance)
    try:
        yield
    finally:
        run("xcrun", "simctl", "ui", udid, "appearance", previous)


@contextmanager
def locked_simulator_record():
    SHARED_SIMULATORS.mkdir(parents=True, exist_ok=True)
    with open(SHARED_SIMULATORS / "lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield SHARED_SIMULATORS / f"{PREVIEW_DEVICE}.udid"


def recorded_simulator(record):
    devices = json.loads(run("xcrun", "simctl", "list", "devices", "available", "--json"))["devices"]
    found = {device["udid"]: (runtime, device["state"]) for runtime, listed in devices.items() for device in listed}
    udid = record.read_text().strip() if record.exists() else None
    runtime, state = found.get(udid, (None, None))
    return udid, runtime, state


@contextmanager
def warm_simulator():
    with locked_simulator_record() as record:
        udid, runtime, state = recorded_simulator(record)
        latest = latest_runtime([PREVIEW_DEVICE])
        if state is not None and runtime != latest:
            if state == "Booted":
                run("xcrun", "simctl", "shutdown", udid)
            run("xcrun", "simctl", "delete", udid)
            state = None
        if state is None:
            udid = run("xcrun", "simctl", "create", f"UI Previews ({PREVIEW_DEVICE})", PREVIEW_DEVICE, latest)
            record.write_text(udid)
        if state != "Booted":
            run("xcrun", "simctl", "bootstatus", udid, "-b")
        yield udid


def previews(screens, appearance, locale):
    started = time.monotonic()
    bundle = build()
    built = time.monotonic()
    with warm_simulator() as udid:
        run("xcrun", "simctl", "install", udid, APP)
        with simulator_appearance(udid, appearance):
            ids = capture(udid, bundle, PREVIEWS, screens, appearance=appearance, locale=locale, timeout=90)
    print(json.dumps({
        "sheet": str(PREVIEWS / "sheet.jpg"),
        "screens": [{"id": id, "png": str(PREVIEWS / f"{id}.png"), "jpg": str(PREVIEWS / "jpg" / f"{id}.jpg")}
                    for id in ids],
        "seconds": {"build": round(built - started, 1), "capture": round(time.monotonic() - built, 1)},
    }, indent=2))


def stop():
    with locked_simulator_record() as record:
        udid, _, state = recorded_simulator(record)
        if state == "Booted":
            run("xcrun", "simctl", "shutdown", udid)
    print(json.dumps({"stopped": udid if state == "Booted" else None}))


def app_store():
    locales = listing_locales()
    runtime = latest_runtime(list(APP_STORE_DISPLAYS.values()))
    bundle = build()
    shutil.rmtree(ROOT / ".local/screenshots", ignore_errors=True)
    for display, device in APP_STORE_DISPLAYS.items():
        udid = run("xcrun", "simctl", "create", "Mumla Screenshots", device, runtime)
        try:
            run("xcrun", "simctl", "bootstatus", udid, "-b")
            run("xcrun", "simctl", "install", udid, APP)
            for locale in locales:
                raw = ROOT / ".local/screenshot-captures" / locale / display
                with simulator_appearance(udid, "light"):
                    capture(udid, bundle, raw, APP_STORE_SCREENS, appearance="light", locale=locale, timeout=300)
                output = ROOT / ".local/screenshots" / locale / display
                output.mkdir(parents=True)
                run("xcrun", "swift", ROOT / "Apple/AppStore/compose.swift", raw, output, locale)
                for slide in sorted(output.glob("*.png")):
                    print(slide, flush=True)
        finally:
            subprocess.run(["xcrun", "simctl", "shutdown", udid], capture_output=True)
            deletion = subprocess.run(["xcrun", "simctl", "delete", udid], capture_output=True)
            if deletion.returncode:
                raise RuntimeError(f"Could not delete screenshot simulator {udid}: {deletion.stderr.decode()}")


def main():
    parser = argparse.ArgumentParser(description="Capture the app's screens from the app itself in the iOS Simulator.")
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("app-store", help="capture the App Store slides into .local/screenshots on fresh simulators")
    previews_parser = commands.add_parser(
        "previews", help="capture screens into .local/ui-previews in the warm simulator this Mac's apps share")
    previews_parser.add_argument("--appearance", choices=("light", "dark"), default="dark")
    previews_parser.add_argument("--locale", choices=sorted(LOCALES), default="en-US")
    previews_parser.add_argument("screens", nargs="*", help="CaptureScreen IDs from ios/MumlaiOS/Sources/Capture.swift; all when omitted")
    commands.add_parser("stop", help="shut down the shared warm simulator")
    args = parser.parse_args()
    if args.command == "app-store":
        app_store()
    elif args.command == "previews":
        previews(args.screens, args.appearance, args.locale)
    else:
        stop()


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, cancel)
    try:
        main()
    except subprocess.CalledProcessError as error:
        raise SystemExit(f"{error.cmd[0]} failed:\n{error.stdout}\n{error.stderr}")
